<controls:JobsTab
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._DV.Lobby.UI.Roles"
    Orientation="Vertical">
    <PanelContainer StyleClasses="TraitsHeaderPanel" Margin="0 0 0 8">
        <BoxContainer Orientation="Vertical" Margin="12 10">
            <!-- Title Row -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
                <Label Text="{Loc 'character-profile-jobs-editor-title'}"
                       StyleClasses="TraitsTitleLabel"/>
                <Control HorizontalExpand="True"/>
                <Label Name="GlobalTraitCountLabel"
                       StyleClasses="TraitsStatLabel"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
    
    <ScrollContainer VerticalExpand="True"
                     HScrollEnabled="False">
        <BoxContainer Name="RoleList"
                      Orientation="Vertical"
                      HorizontalExpand="True"
                      Margin="0 0 4 0" />
    </ScrollContainer>
</controls:JobsTab>